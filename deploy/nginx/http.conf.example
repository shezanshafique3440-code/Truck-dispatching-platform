# Add as a NEW site; replace only the three named deployment variables with envsubst.
# Do not change existing sites, default servers, global proxy files or other ports.
server {
    listen 80;
    listen [::]:80;
    server_name ${DISPATCH_DOMAIN};

    location ^~ /.well-known/acme-challenge/ {
        root ${DISPATCH_ACME_ROOT};
        default_type text/plain;
        try_files $uri =404;
    }
    location / {
        client_max_body_size 3m;
        proxy_pass http://127.0.0.1:${DISPATCH_APP_PORT};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_cache off;
        proxy_buffering off;
        proxy_read_timeout 60s;
    }
}
