# OPTIONAL alternative for an EXISTING Docker reverse proxy. Compose >=2.24.4.
# Copy/review under a new filename and explicitly add -f to Compose commands.
# Do not install another proxy or publish another 80/443 listener.
services:
  app:
    ports: !reset []
    networks:
      web:
      database:
      existing_proxy:
        aliases:
          - ${COMPOSE_PROJECT_NAME}-app
networks:
  existing_proxy:
    external: true
    name: ${PROXY_NETWORK:?Set the existing trusted proxy network name}
