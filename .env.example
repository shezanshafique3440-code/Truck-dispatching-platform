# DEVELOPMENT: copy to .env. VPS: copy to a private .env.production, edit ALL required
# production settings, chmod 600, and see docs/DEPLOYMENT.md. Never commit either file.
# The Compose wrapper accepts DISPATCH_ENV_FILE=/absolute/private/production.env.
# Optional shell-only override: export DISPATCH_COMPOSE_OVERRIDE=/absolute/reviewed/file.yml.
# This is read by the wrapper's shell, not automatically loaded from this env file.

# ---------- Application (local Node startup) ----------
# Used by Node/npm directly. Production Compose builds this connection internally
# from APP_DB_USER, APP_DB_PASSWORD, APP_DATABASE_NAME/POSTGRES_DB and private host db;
# this placeholder DATABASE_URL is deliberately not passed from the file to Compose.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
# Generate at least 32 high-entropy characters; do not share the value in chat.
AUTH_SECRET=""
# Must be the exact HTTPS origin in production (no path, query or trailing route).
# Local HTTP is accepted only with NODE_ENV=development.
APP_URL="http://localhost:3000"
# Optional for local Node development; REQUIRED for the production Compose build.
# Use the approved HTTPS public origin before building (for example the actual domain).
# Changing it later requires rebuilding the image, not just restarting it.
# For this unified public/private VPS installation, use the same origin as APP_URL.
# Local Node builds can fall back to HTTPS APP_URL. No company domain is invented.
PUBLIC_SITE_URL=""
# Optional direct-Node build mode. Leave empty for the existing npm build/start flow.
# Docker sets this to 1 internally and starts the copied standalone server.
NEXT_OUTPUT_STANDALONE=""

# ---------- Production Compose only ----------
# Replace these explicit placeholders. Choose a unique lowercase project name so
# this stack's containers/networks/volumes remain separate from other websites.
COMPOSE_PROJECT_NAME="CHANGE_ME_UNIQUE_PROJECT"
# Use unique image repositories for this installation and a new immutable tag per
# release (for example a reviewed Git SHA). Never reuse latest for rollback tracking.
APP_IMAGE="northlane-dispatch-app"
OPS_IMAGE="northlane-dispatch-ops"
IMAGE_TAG="CHANGE_ME_RELEASE_TAG"
# Bind only on host loopback. Check this port is free on the actual VPS; never use
# 0.0.0.0, port 80 or 443 here. Your existing HTTPS proxy forwards to this port.
APP_BIND_PORT="3108"
# Major versions are intentional. Minor/security updates must be reviewed/rebuilt.
# An approved immutable digest can replace either image reference.
NODE_IMAGE="node:24-bookworm-slim"
NODE_BUILD_IMAGE="node:24-bookworm"
POSTGRES_IMAGE="postgres:17"
# Fresh-volume initialization only. Lowercase names, different maintenance/app roles.
# The maintenance role is privileged; it is never given to the running application.
POSTGRES_USER="dispatch_owner"
POSTGRES_DB="dispatch_production"
POSTGRES_PASSWORD=""
APP_DB_USER="dispatch_app"
# Generate independent 64-character hex values with openssl rand -hex 32.
# Hex is required for APP_DB_PASSWORD so Compose's PostgreSQL URL is safe.
APP_DB_PASSWORD=""
# Usually blank (uses POSTGRES_DB). For a verified restoration to a NEW database,
# set its name here while keeping POSTGRES_DB and the existing volume unchanged.
APP_DATABASE_NAME=""
# Changing password/name env values does not change credentials in an existing
# PostgreSQL volume. Rotate actual roles separately, then update configuration.

# ---------- Optional email and proxy ----------
# Optional: enable password reset email only after verifying sender/provider access.
RESEND_API_KEY=""
MAIL_FROM=""
# Optional: a private, verified recipient for consultation alerts (no default address).
# All three mail settings must be valid; inquiries save without any mail configuration.
INQUIRY_NOTIFICATION_EMAIL=""
# Optional: trust only a header overwritten by an isolated reverse proxy.
# Supported: x-real-ip or cf-connecting-ip. Leave empty for shared-origin throttling.
TRUSTED_CLIENT_IP_HEADER=""

# ---------- Disposable local verification only; never production fixtures ----------
# Optional isolated integration tests; database name MUST end in _test.
TEST_DATABASE_URL=""
SMOKE_BASE_URL="https://localhost:3443"
PLAYWRIGHT_CHROMIUM_EXECUTABLE="/usr/bin/chromium"
REVIEW_OUTPUT_DIR="/tmp/northlane-browser-results"
BOOTSTRAP_INVITATION_FILE=""
# Optional localhost TLS helper inputs, outside checkout; never a production proxy.
LOCAL_TLS_KEY=""
LOCAL_TLS_CERT=""
LOCAL_UPSTREAM_PORT="3001"
LOCAL_TLS_PORT="3443"
